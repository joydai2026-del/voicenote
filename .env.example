# VoiceNote environment variables
# Copy to .env and fill in your values.

# Required
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Optional — enables Supabase storage (falls back to SQLite if absent)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Optional — comma-separated allowed CORS origins (default: all)
VOICENOTE_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# Optional — log level (default: INFO)
VOICENOTE_LOG_LEVEL=INFO

# Optional — SQLite path (default: /tmp/voicenote.db)
VOICENOTE_DB_PATH=/tmp/voicenote.db
